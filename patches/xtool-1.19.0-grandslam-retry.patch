--- /dev/null
+++ b/Sources/XKit/GrandSlam/GrandSlamRetry.swift
@@ -0,0 +1,59 @@
+import Foundation
+import HTTPTypes
+
+struct GrandSlamTransientResponseError: Error, LocalizedError, Sendable {
+    let statusCode: Int
+    let returnedHTML: Bool
+
+    var errorDescription: String? {
+        if returnedHTML {
+            return "Apple GrandSlam returned an HTML response (HTTP \(statusCode))."
+        }
+        return "Apple GrandSlam returned a temporary server error (HTTP \(statusCode))."
+    }
+}
+
+enum GrandSlamRetry {
+    static let maximumAttempts = 5
+
+    static func validate(response: HTTPResponse, body: Data) throws {
+        let returnedHTML = isHTML(response: response, body: body)
+        let isServerError = (500...599).contains(response.status.code)
+        if returnedHTML || isServerError {
+            throw GrandSlamTransientResponseError(
+                statusCode: response.status.code,
+                returnedHTML: returnedHTML
+            )
+        }
+    }
+
+    static func sleep(afterFailedAttempt attempt: Int) async throws {
+        let seconds = 1 << min(attempt, 3)
+        try await Task.sleep(for: .seconds(seconds))
+    }
+
+    static func isHTML(response: HTTPResponse, body: Data) -> Bool {
+        let mimeType = response.headerFields[.contentType]?
+            .split(separator: ";", maxSplits: 1)
+            .first?
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+            .lowercased()
+        if mimeType == "text/html" || mimeType == "application/xhtml+xml" {
+            return true
+        }
+
+        let trimCharacters = CharacterSet.whitespacesAndNewlines
+            .union(CharacterSet(charactersIn: "\u{FEFF}"))
+        var prefix = String(decoding: body.prefix(2_048), as: UTF8.self)
+            .trimmingCharacters(in: trimCharacters)
+            .lowercased()
+        if prefix.hasPrefix("<?xml"), let declarationEnd = prefix.range(of: "?>") {
+            prefix = String(prefix[declarationEnd.upperBound...])
+                .trimmingCharacters(in: trimCharacters)
+        }
+        return prefix.hasPrefix("<!doctype html")
+            || prefix.hasPrefix("<html")
+            || prefix.hasPrefix("<head")
+            || prefix.hasPrefix("<body")
+    }
+}
