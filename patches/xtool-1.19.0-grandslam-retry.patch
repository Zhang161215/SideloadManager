@@ -56,6 +56,33 @@ private struct Client: HTTPClientProtocol {
         URLSessionTransport(configuration: .init(session: session))
     }

+    func makeIsolatedRequest(
+        _ request: HTTPRequest,
+        body: Data?
+    ) async throws -> (response: HTTPResponse, body: Data) {
+        let isolatedSession = URLSession(
+            configuration: .ephemeral,
+            delegate: clientDelegate,
+            delegateQueue: .main
+        )
+        defer { isolatedSession.finishTasksAndInvalidate() }
+
+        let transport = URLSessionTransport(configuration: .init(session: isolatedSession))
+        var baseComponents = URLComponents()
+        baseComponents.scheme = request.scheme
+        baseComponents.host = request.authority
+        let (response, responseBody) = try await transport.send(
+            request,
+            body: body.map { HTTPBody($0) },
+            baseURL: baseComponents.url!,
+            operationID: "grand-slam"
+        )
+
+        guard let responseBody else { return (response, Data()) }
+        let data = try await responseBody.reduce(into: Data()) { $0 += $1 }
+        return (response, data)
+    }
+
