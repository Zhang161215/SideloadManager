diff --git a/Tests/XToolTests/GrandSlamRetryTests.swift b/Tests/XToolTests/GrandSlamRetryTests.swift
new file mode 100644
index 0000000..1a3e8b1
--- /dev/null
+++ b/Tests/XToolTests/GrandSlamRetryTests.swift
@@ -0,0 +1,32 @@
+import Foundation
+import HTTPTypes
+import XCTest
+@testable import XKit
+
+final class GrandSlamRetryTests: XCTestCase {
+    func testNormalXMLPlistIsNotHTML() {
+        let response = HTTPResponse(status: .ok)
+        let body = Data("<?xml version=\"1.0\"?><plist><dict/></plist>".utf8)
+        XCTAssertFalse(GrandSlamRetry.isHTML(response: response, body: body))
+    }
+
+    func testHTMLContentTypesAreDetected() {
+        for contentType in ["text/html; charset=utf-8", "application/xhtml+xml"] {
+            var response = HTTPResponse(status: .ok)
+            response.headerFields[.contentType] = contentType
+            XCTAssertTrue(GrandSlamRetry.isHTML(response: response, body: Data()))
+        }
+    }
+
+    func testHTMLMarkersAreDetectedAfterBOMOrXMLDeclaration() {
+        let response = HTTPResponse(status: .ok)
+        let samples = [
+            "\u{FEFF}  <!DOCTYPE html><html></html>",
+            "<?xml version=\"1.0\"?>\n<html></html>",
+            "\n<head><title>Gateway Error</title></head>",
+        ]
+        for sample in samples {
+            XCTAssertTrue(GrandSlamRetry.isHTML(response: response, body: Data(sample.utf8)))
+        }
+    }
+}
